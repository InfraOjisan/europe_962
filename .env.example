# ローカルPoCサーバー（server/index.mjs）用の環境変数サンプル。
# コピーして .env を作成し、値を埋めてください（.env はgit管理外）。
#   cp .env.example .env

# 生成AI丸投げ方式（aiProvider.ts）で使うAPIキー。
# 未設定の場合は自動的に点数判断（decideByScoring）へフォールバックする
# ——PoCの動作自体はこれが無くても問題なく確認できる。
OPENAI_API_KEY=

# 任意：OpenAI互換の別エンドポイント／モデルを使う場合のみ設定（省略時はOpenAI既定）。
# AI_PROVIDER_ENDPOINT=https://api.openai.com/v1/chat/completions
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=gpt-4o
#
# 注意：Ollama等、キー認証をしないローカル／自己ホストのOpenAI互換エンドポイントを
# AI_PROVIDER_ENDPOINT に指定する場合でも、AI_PROVIDER_API_KEY には何らかの
# 空文字列でない値（例："ollama"や"not-needed"などダミーで構わない）を入れてください。
# aiProvider.ts の判定は「キーが設定されているか」を空文字列かどうかの単純な真偽値で見ており
# （resolveProviderConfig → decideByLLM の `!resolved.apiKey` チェック）、
# AI_PROVIDER_API_KEY= のように空のままだと「未設定」と判定され、エンドポイントの値に
# 関わらず常に点数判断（decideByScoring）へ自動フォールバックしてしまいます
# （起動時ログの「OPENAI_API_KEY が未設定です」もこの判定に基づくもので、
# AI_PROVIDER_API_KEY が空のケースも同じ理由で表示されます）。

# 任意：サーバーの待受ポート（省略時は 4000）。
# PORT=4000
